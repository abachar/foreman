{
  "commands": {
    "root": {
      "build": "xcodebuild build -scheme Wraith -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -derivedDataPath DerivedData",
      "test": "xcodebuild test -scheme Wraith -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -derivedDataPath DerivedData",
      "lint": "swift format lint --strict --recursive Wraith WraithTests",
      "format": "swift format --in-place --recursive Wraith WraithTests",
      "run": "xcodebuild build -scheme Wraith -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -derivedDataPath DerivedData && open -a DerivedData/Build/Products/Debug/Wraith.app"
    }
  },
  "postgres": {
    "host": "localhost",
    "database": "postgres",
    "user": "postgres"
  }
}
