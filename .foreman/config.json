{
  "repos": [
    "."
  ],
  "commands": {
    "root": {
      "$env": {},
      "build": "xcodebuild build -scheme Foreman -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -derivedDataPath DerivedData",
      "test": "xcodebuild test -scheme Foreman -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -derivedDataPath DerivedData",
      "lint": "swift format lint --strict --recursive Foreman ForemanTests",
      "format": "swift format --in-place --recursive Foreman ForemanTests",
      "run": "xcodebuild build -scheme Foreman -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -derivedDataPath DerivedData && open -a DerivedData/Build/Products/Debug/Foreman.app",
      "docs-tree": {
        "run": "ls",
        "cwd": "docs",
        "env": {
          "CLICOLOR": "1"
        }
      }
    }
  },
  "agents": {
    "claude": {
      "title": "Claude Code",
      "command": "claude",
      "icon": "agent-claude",
      "enabled": true
    },
    "antigravity": {
      "title": "Antigravity",
      "command": "agy",
      "icon": "agent-antigravity",
      "enabled": true
    },
    "opencode": {
      "title": "OpenCode",
      "command": "opencode",
      "icon": "agent-opencode",
      "enabled": true
    },
    "pi": {
      "title": "Pi",
      "command": "pi",
      "icon": "agent-pi",
      "enabled": true
    },
    "custom-example": {
      "title": "My agent",
      "command": "my-agent --resume",
      "icon": "terminal",
      "enabled": false
    }
  },
  "postgres": {
    "host": "localhost",
    "port": 5432,
    "database": "postgres",
    "user": "postgres",
    "password": "",
    "sslmode": "prefer",
    "options": {
      "application_name": "foreman"
    },
    "statementTimeout": 30
  },
  "editor": {
    "insertFinalNewline": true
  },
  "formatter": {
    "timeout": 10,
    "swift": "swift format",
    "json": "npx --no-install prettier --stdin-filepath file.json",
    "md": "npx --no-install prettier --stdin-filepath file.md",
    "sh": "shfmt -ln bash"
  },
  "git": {
    "path": "/usr/bin/git"
  },
  "terminal": {
    "font": "JetBrains Mono",
    "fontSize": 13,
    "theme": "system"
  },
  "theme": {
    "interfaceFontSize": 13,
    "islandRadius": 8,
    "gutter": 6,
    "barHeight": 36,
    "rowHeight": 24,
    "contentInset": 12,
    "windowBackground": "#212328",
    "surface": "#36373b",
    "surfaceRaised": "#33363a",
    "surfaceSunken": "#1e2326",
    "surfaceOverlay": "#23262a",
    "textPrimary": "#dfe1e5",
    "textSecondary": "#9da0a8",
    "textDisabled": "#6f737a",
    "separator": "#3d3f44",
    "border": "#45484e",
    "accent": "#4a86e0",
    "accentText": "#ffffff",
    "statusGreen": "#5fb865",
    "statusOrange": "#e0a63b",
    "statusRed": "#e5534b",
    "statusBlue": "#4a86e0"
  },
  "shortcuts": {
    "layout.tab.close": "cmd+w",
    "layout.tab.1": "cmd+1",
    "layout.tab.9": "cmd+9",
    "layout.tab.previous": "cmd+shift+[",
    "layout.tab.next": "cmd+shift+]",
    "layout.split.vertical": "cmd+d",
    "layout.split.horizontal": "cmd+shift+d",
    "layout.focus.left": "cmd+opt+left",
    "layout.focus.right": "cmd+opt+right",
    "layout.focus.up": "cmd+opt+up",
    "layout.focus.down": "cmd+opt+down",
    "layout.move.left": "cmd+opt+shift+left",
    "layout.move.right": "cmd+opt+shift+right",
    "layout.move.up": "cmd+opt+shift+up",
    "layout.move.down": "cmd+opt+shift+down",
    "layout.focus.center": "escape",
    "layout.window.new": "cmd+shift+n",
    "layout.toolbar.toggle": "cmd+opt+t",
    "explorer.tree": "cmd+shift+e",
    "editor.quickOpen": "cmd+p",
    "editor.search": "cmd+shift+f",
    "editor.save": "cmd+s",
    "editor.saveAll": "cmd+opt+s",
    "editor.indent": "cmd+]",
    "editor.outdent": "cmd+[",
    "editor.comment": "cmd+/",
    "editor.moveLine.up": "opt+up",
    "editor.moveLine.down": "opt+down",
    "editor.goToLine": "cmd+l",
    "editor.keepOpen": "cmd+k",
    "editor.find": "cmd+f",
    "editor.replace": "cmd+opt+f",
    "editor.togglePreview": "cmd+shift+v",
    "editor.format": "cmd+shift+l",
    "terminal.clear": "cmd+k",
    "terminal.zoomIn": "cmd+=",
    "terminal.zoomOut": "cmd+-",
    "agents.claude": "cmd+shift+1",
    "run.palette": "cmd+r",
    "run.stop": "cmd+.",
    "git.changes": "cmd+shift+g",
    "git.history": "cmd+shift+h",
    "postgres.schema": "cmd+shift+b",
    "postgres.query": "cmd+shift+q",
    "postgres.comment": "cmd+/",
    "postgres.history": "cmd+shift+o"
  }
}
