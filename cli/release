#!/bin/sh
# Builds a Release archive of Foreman and installs it into /Applications (product R10, M6 task 6.6):
# a local release for a single machine - no signing, notarization, Homebrew or auto-update in v1.
#
# After the first launch macOS asks once (Gatekeeper, unsigned app); `foreman .` then opens the
# installed app through `open -a Foreman` (cli/foreman).
set -eu

root="$(cd -- "$(dirname -- "$0")/.." && pwd -P)"
archive="$root/DerivedData/Foreman.xcarchive"
app="$archive/Products/Applications/Foreman.app"

xcodebuild archive \
    -project "$root/Foreman.xcodeproj" -scheme Foreman -configuration Release \
    -destination 'platform=macOS' -archivePath "$archive" \
    -derivedDataPath "$root/DerivedData" -skipPackagePluginValidation \
    CODE_SIGNING_ALLOWED=NO -quiet

if pgrep -x Foreman >/dev/null; then
    printf 'release: quitting the running Foreman\n'
    pkill -x Foreman
    while pgrep -x Foreman >/dev/null; do sleep 0.5; done
fi

rm -rf /Applications/Foreman.app
ditto "$app" /Applications/Foreman.app
printf 'release: installed /Applications/Foreman.app (%s)\n' "$(defaults read /Applications/Foreman.app/Contents/Info CFBundleShortVersionString 2>/dev/null || echo dev)"
